{
  "name": "homebridge-homehub",
  "type": "module",
  "version": "0.1.0",
  "description": "Bridges Kasa/Tapo lights, Ecobee climate, and August locks into HomeKit, and exposes a small local HTTP API for the HomeHub dashboard to poll and control them through.",
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "config.schema.json",
    "dist"
  ],
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "dependencies": {
    "@kud/androidtv-remote": "^0.1.2",
    "castv2-client": "^1.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "homebridge": "^1.8.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "protobufjs": "^8.8.0"
  }
}
