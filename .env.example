# Copy this file to .env and fill in the values you have. HomeHub runs fully
# without any of the integration credentials below — you'll just see empty
# tiles and "not yet configured" in Settings until you add them. Nothing here
# needs a rebuild; restart `npm run dev` after editing .env.

# --- Core (required) ---------------------------------------------------

# Postgres connection string. On Vercel: Project -> Storage -> Create
# Database -> Postgres — it injects this automatically (and re-applies
# `npm run vercel-build`, which runs migrations, on your next deploy).
# Locally: any Postgres works, e.g. `postgresql://postgres:postgres@localhost:5432/homehub`.
DATABASE_URL=""

# Encrypts OAuth tokens & the Apple app-specific password at rest.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Public base URL of this deployment. Used to build OAuth redirect URIs
# (e.g. http://localhost:3000/api/integrations/google/callback).
APP_URL="http://localhost:3000"

# --- Google Calendar -----------------------------------------------------
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client ID (type: Web application)
# 3. Authorized redirect URI: {APP_URL}/api/integrations/google/callback
# 4. Enable the "Google Calendar API" for the project
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft 365 / Outlook Calendar / Teams -----------------------------
# 1. https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New
# 2. Redirect URI (Web): {APP_URL}/api/integrations/microsoft/callback
# 3. API permissions (delegated): User.Read, Calendars.Read, Chat.Read,
#    offline_access — Chat.Read may need admin consent in a work/school tenant
# 4. Certificates & secrets -> new client secret
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" allows both personal and work/school Microsoft accounts.
MICROSOFT_TENANT_ID="common"

# --- Slack -----------------------------------------------------------------
# 1. https://api.slack.com/apps -> Create New App -> From scratch
# 2. OAuth & Permissions -> Redirect URLs: {APP_URL}/api/integrations/slack/callback
# 3. OAuth & Permissions -> User Token Scopes: channels:history, channels:read,
#    groups:history, groups:read, im:history, im:read, mpim:history, mpim:read,
#    users:read
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# --- Facebook Page (comments, Messenger, insights) --------------------------
# 1. https://developers.facebook.com/apps -> Create App -> Business
# 2. Add the "Facebook Login" product; Valid OAuth Redirect URI:
#    {APP_URL}/api/integrations/facebook/callback
# 3. Connect with an account that is an admin of the Page you want to sync —
#    the callback exchanges the login for that Page's own access token, not
#    your personal profile's.
# 4. pages_show_list, pages_read_engagement, pages_read_user_content,
#    pages_messaging, and read_insights all work in Development Mode for the
#    app's own admins/developers/testers with no App Review needed. App
#    Review is only required once you want people outside your team to
#    connect their own Pages.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Apple Calendar (iCloud) -------------------------------------------------
# No app registration needed — connect it from Settings in the app itself
# using your Apple ID + an app-specific password generated at
# https://appleid.apple.com under Sign-In and Security.
